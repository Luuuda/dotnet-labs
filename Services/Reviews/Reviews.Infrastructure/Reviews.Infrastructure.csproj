<Project Sdk="Microsoft.NET.Sdk">
  <!-- Infrastructure: MongoDB (контекст, BsonClassMap, репозиторії, читання, індекси, сідінг, health check).
       Реалізує інтерфейси, оголошені в Domain (IReviewRepository) і Application (IReviewQueries). -->
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.*" />
    <PackageReference Include="MongoDB.Bson" Version="3.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reviews.Application\Reviews.Application.csproj" />
    <ProjectReference Include="..\Reviews.Domain\Reviews.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Початкові дані для сідінгу — JSON, вбудований у збірку -->
    <EmbeddedResource Include="Seeding\Data\*.json" />
  </ItemGroup>
</Project>
