<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Web/API: контролери, обробка помилок, Swagger (логування — Platform.ServiceDefaults). Стартовий проєкт для dotnet ef. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>cinema-catalog-api-lab03</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.*" />
    <!-- Лаб. 06: gRPC-сервер, кеш у пам'яті (L1) і Redis (L2) через Aspire-інтеграцію -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.*" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.4.2" />
    <!-- Лаб. 07: health checks баз і Redis (Xabaril), gRPC Health Checking Protocol -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.71.0" />
    <!-- Лаб. 08: RabbitMQ через Aspire-інтеграцію (IConnection, RabbitMQ.Client 7.x, повторні спроби підключення) -->
    <PackageReference Include="Aspire.RabbitMQ.Client" Version="13.6.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Контракт gRPC: тут генерується серверна частина; Aggregator підключає той самий файл з GrpcServices="Client" -->
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <!-- Лаб. 05: спільні налаштування платформи (логування, трасування, health checks) -->
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\Platform.EventBus\Platform.EventBus.csproj" />
    <ProjectReference Include="..\CatalogService.Bll\CatalogService.Bll.csproj" />
  </ItemGroup>
</Project>
