<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <!-- .NET Aspire AppHost: SQL Server у контейнері + API однією командою (як у Лаб. 02) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>cinema-catalog-apphost-lab03</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CatalogService.Api\CatalogService.Api.csproj" />
  </ItemGroup>
</Project>
