{
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "reviews-movie-rating": {
        "ClusterId": "reviews",
        "Order": 1,
        "Match": { "Path": "/api/movies/{movieId:int}/rating" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews-movie-title": {
        "ClusterId": "reviews",
        "Order": 1,
        "Match": { "Path": "/api/movies/{movieId:int}/title" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "booking-screenings": {
        "ClusterId": "booking",
        "Order": 1,
        "Match": { "Path": "/api/booking/screenings/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/screenings/{**catch-all}" } ],
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "bookings": {
        "ClusterId": "booking",
        "Order": 10,
        "Match": { "Path": "/api/bookings/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "customers": {
        "ClusterId": "booking",
        "Order": 10,
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "movies": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/movies/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "screenings": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/screenings/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "genres": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/genres/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "halls": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/halls/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 262144,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "discussions": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "booking": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://booking-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  },
  "AllowedHosts": "*"
}
