<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Aggregator Pattern: типізовані gRPC-клієнти до мікросервісів (Лаб. 06; HTTP-клієнти Лаб. 05 — для порівняння),
       service discovery, паралельні виклики Task.WhenAll, часткові відмови → доступні дані + попередження, кеш у Redis. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.*" />
    <!-- Лаб. 06: gRPC-клієнти з DI (Grpc.Net.ClientFactory), генерація коду з .proto, кеш агрегованих відповідей у Redis -->
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0" PrivateAssets="all" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.4.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ті самі контракти, що й у сервісах: сервер генерує GrpcServices="Server", тут — лише клієнтська частина -->
    <Protobuf Include="..\Services\Booking\BookingService.Api\Protos\booking.proto" GrpcServices="Client" Link="Protos\booking.proto" />
    <Protobuf Include="..\Services\Catalog\CatalogService.Api\Protos\catalog.proto" GrpcServices="Client" Link="Protos\catalog.proto" />
    <Protobuf Include="..\Services\Reviews\Reviews.WebApi\Protos\reviews.proto" GrpcServices="Client" Link="Protos\reviews.proto" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
